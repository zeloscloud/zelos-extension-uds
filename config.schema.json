    "advanced": {
      "type": "object",
      "title": "Advanced",
      "description": "Settings that apply to every ECU.",
      "properties": {
        "prefix": {
          "type": "string",
          "title": "Prefix",
          "description": "Leading trace source every ECU publishes under, so events read '<prefix>/<ecu>/tx'. Clear it to give each ECU its own trace source with events 'tx' and 'rx'.",
          "default": "UDS",
          "ui:placeholder": "UDS",
          "ui:emptyValue": ""
        },
        "log_level": {
          "type": "string",
          "title": "Log Level",
          "description": "Extension logging verbosity",
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR"
          ],
          "default": "INFO"
        },
        "request_timeout": {
          "type": "number",
          "title": "Request Timeout (seconds)",
          "description": "Longest a request may take in total, response-pending answers included.",
          "default": 5.0,
          "minimum": 0.1,
          "maximum": 600.0
        },
        "p2_timeout": {
          "type": "number",
          "title": "P2 Timeout (seconds)",
          "description": "How long to wait for the ECU's first response.",
          "default": 1.0,
          "minimum": 0.01,
          "maximum": 30.0
        },
        "p2_star_timeout": {
          "type": "number",
          "title": "P2* Timeout (seconds)",
          "description": "How long to wait after each response-pending (NRC 0x78) answer.",
          "default": 5.0,
          "minimum": 0.1,
          "maximum": 600.0
        },
        "isotp_stmin": {
          "type": "integer",
          "title": "ISO-TP STmin (ms)",
          "description": "Minimum gap the ECU must leave between consecutive frames it sends us, in our flow control frames.",
          "default": 0,
          "minimum": 0,
          "maximum": 127
        },
        "isotp_blocksize": {
          "type": "integer",
          "title": "ISO-TP Block Size",
          "description": "Consecutive frames the ECU may send before waiting for our next flow control; 0 for all, one flow control per message. Over a slow link (SSH) each flow control costs a round trip.",
          "default": 0,
          "minimum": 0,
          "maximum": 255
        },
        "isotp_padding": {
          "type": [
            "integer",
            "null"
          ],
          "title": "ISO-TP Padding Byte",
          "description": "Pad every frame we send to 8 bytes with this byte (default 204 = 0xCC, as ISO 15765-4 requires on OBD ids); empty: unpadded. CAN FD frames are always padded to a valid length.",
          "default": 204,
          "ui:emptyValue": null,
          "minimum": 0,
          "maximum": 255
        },
        "tester_present_s": {
          "type": "number",
          "title": "Tester Present Period (seconds)",
          "description": "Send tester present (suppressed response) to every ECU at this period from the start, to hold non-default sessions; empty: off. The Periodic Tester Present action changes it per ECU.",
          "minimum": 0.5,
          "maximum": 10.0
        },
        "debug_frames": {
          "type": "boolean",
          "title": "Debug Frames",
          "description": "Log every request, response and ISO-TP frame at DEBUG level.",
          "default": false,
          "ui:widget": "toggle"
        }
      },
      "additionalProperties": false,
      "default": {},
      "ui:options": {
        "collapsed": true
      }
    }
