                    "description": "Provide complete python-can Bus() kwargs as JSON. Must include 'interface' and 'channel' keys. Example: {\"interface\": \"ixxat\", \"channel\": 0, \"bitrate\": 500000}"
                  },
                  "tx_id": {
                    "type": "string",
