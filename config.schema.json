{
  "$comment": "UDS extension configuration schema. See https://docs.zeloscloud.io/sdk/how-to/develop-extensions/#configuration",
  "type": "object",
  "title": "UDS Configuration",
  "description": "Diagnose one or more ECUs over UDS (ISO 14229) on CAN with ISO-TP, or on DoIP.",
  "ui:options": {
    "autoconfig": "UDS/auto_config"
  },
  "properties": {
    "ecus": {
      "type": "array",
      "title": "ECUs",
      "description": "Add an ECU for each UDS server (one request/response CAN id pair), or use Auto-configure for a demo ECU.",
      "items": {
        "title": "ECU",
        "type": "object",
        "properties": {
          "interface": {
            "type": "string",
            "title": "Interface",
            "description": "How the extension reaches the ECU: SocketCAN (Linux), SocketCAN over SSH (a remote Linux device's SocketCAN over SSH, from any OS), PCAN, Kvaser, Vector, slcan, or Other (any python-can interface). Demo: a built-in simulated ECU with no hardware. DoIP: UDS over TCP/IP (ISO 13400) to a DoIP entity, the ECU itself or a gateway in front of it. ECUs on one interface and channel share one bus and must agree on its bitrate and CAN-FD settings. The bus opens when the extension starts.",
            "enum": [
              "SocketCAN",
              "SocketCAN over SSH",
              "PCAN",
              "Kvaser",
              "Vector",
              "slcan (serial)",
              "Other (python-can)",
              "Demo",
              "DoIP"
            ]
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Name the actions take as `ecu` and the trace shows. Letters, digits, space, '_' and '-' only. Defaults to the CAN channel, sanitized, 'demo' or 'doip'.",
            "pattern": "^[A-Za-z0-9 _-]*$",
            "ui:placeholder": "bms"
          },
          "key_file": {
            "type": "string",
            "title": "Seed/Key File",
            "description": "A Python file defining key(level: int, seed: bytes) -> bytes, run in the extension on the agent's host. Answers security access seeds when no key is given, and in Flash Firmware. Empty: keys are entered by hand.",
            "ui:widget": "file-picker",
            "ui:options": {
              "accept": ".py"
            }
          }
        },
        "required": [
          "interface"
        ],
        "dependencies": {
          "interface": {
            "oneOf": [
              {
                "properties": {
                  "interface": {
                    "enum": [
                      "SocketCAN"
                    ]
                  },
                  "channel": {
                    "type": "string",
                    "title": "Channel",
                    "description": "SocketCAN interface name (can0, vcan0, slcan0, ...). Choose from the interfaces on the machine running the agent, or type a name.",
                    "default": "can0",
                    "ui:widget": "action-choices",
                    "ui:options": {
                      "action": "UDS/list_interfaces"
                    }
                  },
                  "fd_mode": {
                    "type": "boolean",
                    "title": "CAN-FD Mode",
                    "description": "Enable CAN-FD for higher data rates and larger payloads",
                    "default": false,
                    "ui:widget": "toggle"
                  },
                  "config_json": {
                    "type": "string",
                    "title": "Advanced Configuration (JSON)",
                    "description": "Additional python-can Bus() kwargs as JSON object"
                  },
                  "tx_id": {
                    "type": "string",
                    "title": "Request CAN ID",
                    "description": "CAN id the extension sends requests on (tester to ECU, physical addressing), hex, e.g. 0x7E0.",
                    "pattern": "^(0[xX])?[0-9A-Fa-f]{1,8}$",
                    "default": "0x7E0",
                    "ui:placeholder": "0x7E0"
                  },
                  "rx_id": {
                    "type": "string",
                    "title": "Response CAN ID",
                    "description": "CAN id the ECU answers on (ECU to tester), hex, e.g. 0x7E8.",
                    "pattern": "^(0[xX])?[0-9A-Fa-f]{1,8}$",
                    "default": "0x7E8",
                    "ui:placeholder": "0x7E8"
                  },
                  "extended_ids": {
                    "type": "boolean",
                    "title": "Extended IDs",
                    "description": "The two CAN ids above are 29-bit extended ids.",
                    "default": false,
                    "ui:widget": "toggle"
                  }
                },
                "required": [
                  "channel",
                  "tx_id",
                  "rx_id"
                ],
                "dependencies": {
                  "fd_mode": {
                    "oneOf": [
                      {
                        "properties": {
                          "fd_mode": {
                            "enum": [
                              false
                            ]
                          }
                        }
                      },
                      {
                        "properties": {
                          "fd_mode": {
                            "enum": [
                              true
                            ]
                          },
                          "data_bitrate": {
                            "type": "integer",
                            "title": "CAN-FD Data Bitrate (bps)",
                            "description": "CAN-FD data phase bitrate",
                            "enum": [
                              500000,
                              1000000,
                              2000000,
                              4000000,
                              8000000
                            ],
                            "default": 2000000
                          }
                        },
                        "required": [
                          "data_bitrate"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "properties": {
                  "interface": {
                    "enum": [
                      "SocketCAN over SSH"
                    ]
                  },
                  "remote_host": {
                    "type": "string",
                    "title": "Remote Host",
                    "description": "Hostname or IP of the edge device running SocketCAN, reached over SSH (may be a ~/.ssh/config alias)"
                  },
                  "remote_channel": {
                    "type": "string",
                    "title": "Remote CAN Channel",
                    "description": "SocketCAN interface name on the remote edge device (e.g. can0, vcan0)",
                    "default": "can0"
                  },
                  "ssh_user": {
                    "type": "string",
                    "title": "SSH User",
                    "description": "Username for the SSH connection (optional; falls back to your ssh config / current user)"
                  },
                  "ssh_port": {
                    "type": "integer",
                    "title": "SSH Port",
                    "description": "TCP port for the SSH connection",
                    "default": 22
                  },
                  "ssh_key_path": {
                    "type": "string",
                    "title": "SSH Key File",
                    "description": "Path to a private key file for SSH authentication (optional)",
                    "ui:widget": "file-picker"
                  },
                  "ssh_host_key_policy": {
                    "type": "string",
                    "title": "SSH Host Key Policy",
                    "description": "How to treat the edge's SSH host key. 'auto' trusts whatever key the device presents and records nothing, so a reimaged device (which comes back with a new key) reconnects with no manual step. 'strict' uses your own ~/.ssh/known_hosts: an unknown or changed key is reported and the bus stops, rather than retrying.",
                    "enum": [
                      "auto",
                      "strict"
                    ],
                    "default": "auto"
                  },
                  "ssh_extra_opts": {
                    "type": "string",
                    "title": "SSH Extra Options",
                    "description": "Additional ssh command-line options, space-separated (e.g. -J bastion). Placed before the options above; ssh honors the first -o it sees, so these win over the settings above."
                  },
                  "ssh_hw_timestamps": {
                    "type": "boolean",
                    "title": "Hardware timestamps",
                    "description": "Uses the adapter's hardware clock when the edge's candump supports -H; interfaces without one (vcan, some slcan) fall back to the extension's wall clock. Turn off to use the edge kernel's receive time.",
                    "default": true,
                    "ui:widget": "toggle"
                  },
                  "fd_mode": {
                    "type": "boolean",
                    "title": "CAN-FD Mode",
                    "description": "Enable CAN-FD for higher data rates and larger payloads",
                    "default": false,
                    "ui:widget": "toggle"
                  },
                  "tx_id": {
                    "type": "string",
                    "title": "Request CAN ID",
                    "description": "CAN id the extension sends requests on (tester to ECU, physical addressing), hex, e.g. 0x7E0.",
                    "pattern": "^(0[xX])?[0-9A-Fa-f]{1,8}$",
                    "default": "0x7E0",
                    "ui:placeholder": "0x7E0"
                  },
                  "rx_id": {
                    "type": "string",
                    "title": "Response CAN ID",
                    "description": "CAN id the ECU answers on (ECU to tester), hex, e.g. 0x7E8.",
                    "pattern": "^(0[xX])?[0-9A-Fa-f]{1,8}$",
                    "default": "0x7E8",
                    "ui:placeholder": "0x7E8"
                  },
                  "extended_ids": {
                    "type": "boolean",
                    "title": "Extended IDs",
                    "description": "The two CAN ids above are 29-bit extended ids.",
                    "default": false,
                    "ui:widget": "toggle"
                  }
                },
                "required": [
                  "interface",
                  "remote_host",
                  "tx_id",
                  "rx_id"
                ]
              },
              {
                "properties": {
                  "interface": {
                    "enum": [
                      "PCAN"
                    ]
                  },
                  "channel": {
