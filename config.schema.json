                "properties": {
                  "interface": {
                    "enum": [
                      "DoIP"
                    ]
                  },
                  "doip": {
                    "type": "object",
                    "title": "DoIP",
                    "properties": {
                      "host": {
                        "type": "string",
                        "title": "Host",
                        "description": "IP address or hostname of the DoIP entity: the ECU, or the gateway in front of it. Empty with Discover: found by a broadcast vehicle identification request, which exactly one entity must answer.",
                        "ui:placeholder": "192.168.77.2"
                      },
                      "port": {
                        "type": "integer",
                        "title": "TCP Port",
                        "description": "The entity's diagnostic TCP port.",
                        "default": 13400,
                        "minimum": 1,
                        "maximum": 65535
                      },
                      "tester_address": {
                        "type": "string",
                        "title": "Tester Logical Address",
                        "description": "The extension's own logical address (source address), hex. The entity must accept it in routing activation.",
                        "pattern": "^(0[xX])?[0-9A-Fa-f]{1,4}$",
                        "default": "0x0E80"
                      },
                      "ecu_address": {
                        "type": "string",
                        "title": "ECU Logical Address",
                        "description": "The ECU's logical address (target address), hex. Empty with Discover: the address the entity reports, right for an ECU that is its own entity; behind a gateway set the ECU's.",
                        "pattern": "^((0[xX])?[0-9A-Fa-f]{1,4})?$",
                        "ui:placeholder": "0x1001"
                      },
                      "activation_type": {
                        "type": "string",
                        "title": "Routing Activation Type",
                        "description": "Hex: 0x00 default, 0x01 WWH-OBD, 0xE0 central security, 0xE1 to 0xFF OEM-specific.",
                        "pattern": "^(0[xX])?[0-9A-Fa-f]{1,2}$",
                        "default": "0x00"
                      },
                      "tcp_timeout": {
                        "type": "number",
                        "title": "TCP Timeout (s)",
                        "description": "Bounds the TCP connect and the entity's acknowledgement of each request.",
                        "default": 2.0,
                        "exclusiveMinimum": 0
                      },
                      "discover": {
                        "type": "boolean",
                        "title": "Discover",
                        "description": "Before connecting, send a vehicle identification request (UDP 13400) to Host, or broadcast without one. The answer (IP, logical address, VIN, EID) shows in Get Status.",
                        "default": false,
                        "ui:widget": "toggle"
                      }
                    },
                    "dependencies": {
                      "discover": {
                        "oneOf": [
                          {
                            "properties": {
                              "discover": {
                                "enum": [
                                  false
                                ]
                              }
                            },
                            "required": [
                              "host",
                              "ecu_address"
                            ]
                          },
                          {
                            "properties": {
                              "discover": {
                                "enum": [
                                  true
                                ]
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                },
                "required": [
                  "doip"
                ]
              }
            ]
          }
        },
        "ui:order": [
          "interface",
